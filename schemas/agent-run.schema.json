{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbs-tech.com/schemas/agent-run.schema.json",
  "title": "QBS Agent Run",
  "type": "object",
  "required": ["schemaVersion", "runId", "agent", "task", "startedAt", "outcome"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "runId": { "type": "string", "minLength": 1 },
    "workflow": { "type": "string" },
    "workflowRunId": { "type": ["string", "integer"] },
    "repository": { "type": "string" },
    "trigger": { "type": "string" },
    "agent": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "engine": { "type": "string" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "modelRequested": { "type": "string" },
    "modelObserved": { "type": "string" },
    "policyVersion": { "type": "string" },
    "promptVersion": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationSeconds": { "type": "number", "minimum": 0 },
    "filesChanged": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "toolsUsed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cachedTokens": { "type": "integer", "minimum": 0 },
        "aiCredits": { "type": "number", "minimum": 0 },
        "estimatedUsd": { "type": "number", "minimum": 0 },
        "premiumRequests": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "trajectory": {
      "type": "object",
      "properties": {
        "toolSuccessRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "toolFailureCount": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 },
        "loops": { "type": "integer", "minimum": 0 },
        "objectiveCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "groundingAccuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "evals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["YES", "NO", "UNKNOWN"] },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "graders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "error", "unavailable"] },
          "value": { "type": ["number", "integer", "boolean", "string", "null"] },
          "unit": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "failed", "skipped"] },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "status"],
        "properties": {
          "action": { "type": "string" },
          "status": { "enum": ["not_required", "requested", "approved", "denied"] },
          "approver": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "safeOutputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "status"],
        "properties": {
          "type": { "type": "string" },
          "status": { "enum": ["applied", "blocked", "skipped", "failed", "warning"] },
          "target": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "outcome": { "enum": ["passed", "failed", "blocked", "cancelled"] },
    "residualRisk": { "type": "string" }
  },
  "additionalProperties": false
}
